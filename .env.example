# Public Supabase project configuration. These values identify the project but do
# not grant privileged database access; RLS remains mandatory.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Server-only. A random 32+ byte value used for origin-bound mutation checks.
APP_ORIGIN=https://your-production-domain.example

# Optional exchange-rate endpoint. The app always allows a manual rate.
EXCHANGE_RATE_API_URL=https://api.frankfurter.dev
