# Public Supabase project configuration. These values identify the project but do
# not grant privileged database access; RLS remains mandatory.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Server-only. The exact HTTPS origin allowed to submit production mutations.
APP_ORIGIN=https://your-production-domain.example

# Server-only HMAC key for short-lived password-recovery authorization. Generate
# a unique random value of at least 32 characters and configure it in Vercel.
AUTH_RECOVERY_SECRET=replace_with_a_unique_random_value_of_at_least_32_characters

# Optional exchange-rate endpoint. The app always allows a manual rate.
EXCHANGE_RATE_API_URL=https://api.frankfurter.dev
